{
  "redirects": [
    {
      "source": "https://www.costafisiofitness.it/:path*",
      "destination": "https://costafisiofitness.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*/",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images|favicon.ico|robots.txt|sitemap.xml|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
